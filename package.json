{
  "name": "deskpet",
  "version": "0.1.0",
  "description": "🐾 一个基于 Deepseek API 的智能桌面宠物",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "generate-icons": "node scripts/generate-icons.mjs",
    "dev": "npm run generate-icons && electron-vite dev",
    "build": "npm run generate-icons && electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:linux": "electron-vite build && electron-builder --linux",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pixi/canvas-display": "^7.4.3",
    "@pixi/canvas-graphics": "^7.4.3",
    "@pixi/canvas-renderer": "^7.4.3",
    "@pixi/canvas-sprite": "^7.4.3",
    "@pixi/unsafe-eval": "^7.4.3",
    "live2d-widget-model-shizuku": "^1.0.5",
    "pixi-live2d-display": "^0.5.0-beta",
    "pixi.js": "^7.4.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "sharp": "^0.34.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.deskpet.app",
    "productName": "DeskPet",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "public/icon.png"
    }
  }
}
